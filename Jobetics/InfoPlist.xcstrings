    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add your milestones and meetings to your calendar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tus entregas y reuniones a tu calendario."
          }
        },
