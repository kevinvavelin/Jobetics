    "NSCameraUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take pictures of your work for your portfolio, or of receipts for your expenses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz fotos de tu trabajo para tu portfolio o de los recibos de tus gastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photographiez vos réalisations pour votre portfolio, ou vos reçus pour vos dépenses."
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a client from your contacts when creating an invoice or a quote."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un cliente de tus contactos al crear una factura o un presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un client dans vos contacts lors de la création d'une facture ou d'un devis."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Face ID to protect your invoices and accounting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Face ID para proteger tus facturas y tu contabilidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Face ID pour protéger vos factures et votre comptabilité."
          }
        }
      }
    },
    "NSSiriUsageDescription" : {
      "comment" : "Info.plist",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask Siri to show new jobs or start a focus session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide a Siri que muestre trabajos nuevos o inicie una sesión de enfoque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez à Siri d'afficher les nouvelles missions ou de lancer une session de focus."
          }
        }
      }
